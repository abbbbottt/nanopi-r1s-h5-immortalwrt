#
# ============================================================================
#  NanoPi R1S H5（友善 R1S H5 / Allwinner H5）编译配置片段
#  基座：ImmortalWrt 25.12.2  ·  sunxi / cortexa53  ·  Linux 6.12
#
#  用法：本文件会被追加到源码根目录的 .config 之后，再执行 `make defconfig`。
#        行首带 # 的都是注释，不会被解析；不存在的选项会被 defconfig 静默忽略，
#        所以这里可以放心地写得宽松一些。
# ============================================================================
#

# ---------------------------------------------------------------------------
# 1. 目标平台 / 设备
# ---------------------------------------------------------------------------
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-r1s-h5=y
# 只编这一台设备，不编同子目标下的其它板子（省时间）
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
CONFIG_TARGET_ALL_PROFILES=n

# ---------------------------------------------------------------------------
# 2. 镜像格式（两种都出，随便挑）
#    ext4    : 可读写单分区，和友善原厂镜像结构一致，方便跑 Docker
#    squashfs: 只读根 + 可写 overlay，网页升级 / 一键恢复出厂更省心
# ---------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
# 注意：512 会被下面这一堆包撑爆（实测根文件系统约 511MB，
# 报 "ext4_allocate_best_fit_partial: failed to allocate 175 blocks"）。
# 这个 target 不会自动扩容根分区（全树无 resize 脚本），
# 1024 就是刷完后在卡上的可用大小，想用满整卡需刷完手动扩第二分区。
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_UBIFS=n

# ---------------------------------------------------------------------------
# 3. 板载 WiFi：Realtek RTL8189ETV（SDIO 接口，走树外驱动）
#    —— 这是本次编译最核心的一项，漏掉它就没有 WiFi
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-rtl8189es=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
# 也可换成 wpad-openssl / wpad-mesh-mbedtls，家庭 AP 用 basic 足够
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_hostapd-utils=y

# ---------------------------------------------------------------------------
# 4. LuCI 与中文界面
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-mod-dashboard=y

# ---------------------------------------------------------------------------
# 5. 科学上网：PassWall（轻） + OpenClash（功能全，但会拖入 ruby，体积较大）
#    两个都在 ImmortalWrt 自带的 luci 源里，不需要额外 feeds
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_v2ray-geodata=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y

# ---------------------------------------------------------------------------
# 6. 网络存储 / 下载
#    提醒：R1S H5 只有 512MB 内存，Docker 跑得动但别指望性能；
#          不想要 Docker 就把 luci-app-dockerman 那两行删掉。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-app-filebrowser-go=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-dockerman=y
# 挂载 U 盘 / 移动硬盘所需的文件系统
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_usbutils=y

# ---------------------------------------------------------------------------
# 7. 常用小工具
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# ---------------------------------------------------------------------------
# 8. USB 移动宽带（4G / 5G 上网卡、随身 WiFi、手机 USB 共享）
#    —— 官方 25.12.2 镜像默认一个都不带，必须显式选中
#    这里的驱动覆盖了几乎所有 USB 上网设备形态：
#      RNDIS / CDC-ECM  : 绝大多数「随身 WiFi」和手机 USB 共享
#      CDC-NCM          : 较新的 5G 随身 WiFi、部分华为设备
#      QMI              : 高通 5G 模块（RM500Q / MH5000 等），用 uqmi 拨号
#      MBIM             : 高通/移远模块的另一种模式，用 umbim 拨号
#      Serial(option)   : AT 指令口，发短信 / 查信号 / 解 PIN
#    注意：内核模块与固件内核配置哈希强绑定，官方源里的 kmod 装不进本固件，
#          所以必须像这样编进固件，不能刷完再 apk add。
# ---------------------------------------------------------------------------
# --- 8.1 内核驱动 ---
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
# 苹果手机 USB 共享（可选，用不到可删）
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-wwan=y

# --- 8.2 用户态工具 ---
# usb-modeswitch：很多上网卡插上先伪装成光驱，需要它切到网卡模式
CONFIG_PACKAGE_usb-modeswitch=y
# QMI / MBIM / NCM / 3G 拨号工具
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_comgt-directip=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_libmbim=y
# 排查利器：qmicli / mbimcli / picocom(串口连 AT) / sms-tool(收发短信)
CONFIG_PACKAGE_picocom=y
CONFIG_PACKAGE_sms-tool=y

# --- 8.3 LuCI 界面 ---
# 纯 RNDIS/ECM 网卡不需要下面这些，当普通以太网口加个 DHCP 接口即可；
# 但 QMI/MBIM/NCM 必须有对应 proto 才能新建接口。
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y
# 信号强度 / 频段 / 短信（中文界面）
CONFIG_PACKAGE_luci-app-3ginfo-lite=y
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
# ModemManager：能自动识别绝大多数模块（mmcli 命令）。
# 默认不启动；如果你的模块用 QMI/MBIM 都拨不上，再手动启用它接管。
CONFIG_PACKAGE_modemmanager=y

# ---------------------------------------------------------------------------
# 9. 构建加速
# ---------------------------------------------------------------------------
CONFIG_CCACHE=y
